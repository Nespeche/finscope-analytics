{
  "$id": "https://finscope.local/schemas/requirements-acceptance-traceability.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirements acceptance and plan traceability v5.0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrixId",
    "version",
    "status",
    "requirementCount",
    "criterionCount",
    "invariants",
    "requirements",
    "criteria",
    "planResolutionPolicy",
    "planComponents"
  ],
  "properties": {
    "matrixId": {
      "const": "requirements-acceptance-traceability"
    },
    "version": {
      "const": "5.0.4"
    },
    "status": {
      "const": "ACTIVE_AUTHORITY"
    },
    "requirementCount": {
      "const": 49
    },
    "criterionCount": {
      "const": 84
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 49,
      "maxItems": 49,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementId",
          "statement",
          "criterionIds",
          "planRef",
          "planSection",
          "componentId",
          "contractRefs",
          "schemaRefs",
          "testStrategy"
        ],
        "properties": {
          "requirementId": {
            "type": "string",
            "pattern": "^(?:FR|NFR)-[0-9]{3}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "criterionIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{3}$"
            }
          },
          "planRef": {
            "type": "string",
            "pattern": "^specs/001-fundamental-analysis-platform/plan\\.md#component-[a-z0-9-]+$"
          },
          "planSection": {
            "type": "string",
            "minLength": 1
          },
          "componentId": {
            "type": "string",
            "pattern": "^COMP-[A-Z0-9-]+$"
          },
          "contractRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "schemaRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "testStrategy": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 84,
      "maxItems": 84,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterionId",
          "requirementIds",
          "fixtureRef",
          "authorityRef",
          "authorityId"
        ],
        "properties": {
          "criterionId": {
            "type": "string",
            "pattern": "^AC-[0-9]{3}$"
          },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:FR|NFR)-[0-9]{3}$"
            }
          },
          "fixtureRef": {
            "type": "string"
          },
          "authorityRef": {
            "type": "string"
          },
          "authorityId": {
            "type": "string",
            "pattern": "^AUTH-[0-9]{3}$"
          }
        }
      }
    },
    "planResolutionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normativeRoot",
        "planAuthorityRef",
        "forwardInvariant",
        "reverseInvariant",
        "physicalResolution",
        "semanticInference"
      ],
      "properties": {
        "normativeRoot": {
          "const": "packageRoot"
        },
        "planAuthorityRef": {
          "const": "specs/001-fundamental-analysis-platform/plan.md"
        },
        "forwardInvariant": {
          "type": "string",
          "minLength": 1
        },
        "reverseInvariant": {
          "type": "string",
          "minLength": 1
        },
        "physicalResolution": {
          "type": "string",
          "minLength": 1
        },
        "semanticInference": {
          "const": "PROHIBITED"
        }
      }
    },
    "planComponents": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentId",
          "planRef",
          "planSection",
          "requirementIds",
          "contractRefs",
          "schemaRefs",
          "testStrategy",
          "criterionIds"
        ],
        "properties": {
          "componentId": {
            "type": "string",
            "pattern": "^COMP-[A-Z0-9-]+$"
          },
          "planRef": {
            "type": "string",
            "pattern": "^specs/001-fundamental-analysis-platform/plan\\.md#component-[a-z0-9-]+$"
          },
          "planSection": {
            "type": "string",
            "minLength": 1
          },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:FR|NFR)-[0-9]{3}$"
            }
          },
          "contractRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "schemaRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "testStrategy": {
            "type": "string",
            "minLength": 1
          },
          "criterionIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{3}$"
            }
          }
        }
      }
    }
  }
}
