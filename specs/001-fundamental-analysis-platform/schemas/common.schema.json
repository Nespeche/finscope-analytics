{
  "$defs": {
    "AccountingProfileId": {
      "enum": [
        "general_operating_us_gaap",
        "general_operating_ifrs_limited",
        "financial_institution_limited",
        "insurance_limited",
        "reit_limited",
        "unsupported_profile"
      ],
      "type": "string"
    },
    "BlockedOperation": {
      "enum": [
        "requested_operation",
        "requested_resource",
        "acquisition",
        "normalization",
        "persistence",
        "active_operation"
      ],
      "type": "string"
    },
    "Capability": {
      "enum": [
        "issuer_identity",
        "filings",
        "fundamentals",
        "insights",
        "local_snapshot",
        "price_import",
        "price_descriptive",
        "evidence",
        "definitions",
        "mappings"
      ],
      "type": "string"
    },
    "Cik": {
      "pattern": "^[0-9]{10}$",
      "type": "string"
    },
    "CoverageState": {
      "enum": [
        "complete",
        "partial",
        "missing",
        "not_applicable"
      ],
      "type": "string"
    },
    "CurrencyCode": {
      "pattern": "^(?:[A-Z]{3}|XXX)$",
      "type": "string"
    },
    "DecimalString": {
      "pattern": "^(?:0|-?(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9]))$",
      "type": "string",
      "description": "Canonical finite base-10 decimal string. Zero is exactly \"0\". Exponential notation, leading plus signs, leading integer zeroes, trailing fractional zeroes and negative zero are forbidden.",
      "examples": [
        "0",
        "12",
        "-7",
        "0.125",
        "-0.25",
        "12.34"
      ]
    },
    "FactResolutionState": {
      "enum": [
        "resolved",
        "absent",
        "ambiguous",
        "incompatible"
      ],
      "type": "string"
    },
    "IsoDate": {
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "MetricState": {
      "enum": [
        "available",
        "partial",
        "insufficient",
        "not_applicable",
        "not_meaningful"
      ],
      "type": "string"
    },
    "PipelineState": {
      "enum": [
        "idle",
        "checking",
        "acquiring",
        "normalizing",
        "analyzing",
        "ready",
        "partial",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "PositiveDecimalString": {
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$",
      "type": "string"
    },
    "QualityClassification": {
      "enum": [
        "verified",
        "usable_with_caveats",
        "insufficient"
      ],
      "type": "string"
    },
    "RuleState": {
      "enum": [
        "triggered",
        "not_triggered",
        "not_evaluable"
      ],
      "type": "string"
    },
    "Sha256Fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "SynthesisState": {
      "enum": [
        "insufficient_information",
        "neutral",
        "favorable",
        "unfavorable",
        "mixed"
      ],
      "type": "string"
    }
  },
  "$id": "https://finscope.local/schemas/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinScope common canonical types v0.19.2"
}
