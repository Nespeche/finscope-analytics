    "buckets": [
      "shortTermBorrowings",
      "currentPortionLongTermDebt",
      "longTermDebtNoncurrent",
      "commercialPaper",
      "otherApprovedInterestBearingBorrowings"
    ],
    "completeConditions": [
      "every included fact resolves through an ACTIVE exact or approved_alias mapping",
      "all included facts share instant date, scope, currency and lineage",
      "no overlap pair is unresolved",
      "any issuer-extension debt tag requires a separately approved exact mappingId before inclusion"
    ],
    "dependentMetricPolicy": "partial or insufficient borrowingsDebt forces FND_NET_DEBT and FND_DEBT_EQUITY to insufficient",
    "directTotalPolicy": "disabled_by_default; a direct total may be used only through a separately ACTIVE exact mapping that explicitly excludes leases and operating liabilities; no such generic mapping is active in the MVP",
    "insufficientConditions": [
      "no approved bucket resolves and absence of debt cannot be established",
      "currency, scope or instant date are incompatible"
    ],
    "knownAbsentConcepts": [
      {
        "canonicalConceptId": "otherApprovedInterestBearingBorrowings",
        "impactOnMetrics": [
          "FND_BORROWINGS_DEBT may reach partial state for issuers with non-standard debt tagging; this cascades to FND_NET_DEBT and FND_DEBT_EQUITY per dependentMetricPolicy"
        ],
        "intent": "known_absent_intent",
        "rationale": "No canonical US-GAAP or IFRS XBRL tag maps to a residual catch-all for interest-bearing borrowings that are not ShortTermBorrowings, CurrentPortionLongTermDebt, LongTermDebtNoncurrent, or CommercialPaper. Company-specific extension tags require a separately approved exact mappingId per the completeConditions rule. Absence of this bucket does not trigger insufficient unless all other buckets also fail to resolve.",
        "remediation": "NF-002 v0.18: formally declared known_absent_intent to resolve cross-document gap identified in audit"
      }
    ],
    "leaseTreatment": "excluded",
    "operatingLiabilitiesExcluded": true,
    "partialConditions": [
      "at least one approved bucket resolves and completeness cannot be proven",
      "an overlap remains unresolved",
      "an observed issuer-extension borrowing tag lacks an ACTIVE mapping"
    ],
    "policyId": "borrowings-debt-v2",
    "version": "5.0.0"
  },
