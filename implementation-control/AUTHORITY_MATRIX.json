{
  "$schema": "schemas/authority-matrix.schema.json",
  "schemaVersion": "2.0.0",
  "fieldAuthorities": [
    {
      "fieldId": "constitutional_rules",
      "scope": "Principles, limits and SDD order",
      "authority": ".specify/memory/constitution.md",
      "mirrors": [
        "START_HERE_CHATGPT.md",
        "implementation-control/PROJECT_CONFIGURATION_INSTRUCTIONS.txt"
      ],
      "forbiddenOverrides": [
        "reports",
        "prompts",
        "evidence"
      ]
    },
    {
      "fieldId": "phase_gate_flags",
      "scope": "All *Authorized flags",
      "authority": "V0.21_PHASE_STATUS.md#gate",
      "mirrors": [],
      "forbiddenOverrides": [
        "PR body",
        "workflow inputs",
        "reports"
      ]
    },
    {
      "fieldId": "product_requirements",
      "scope": "FR/NFR and scope",
      "authority": "specs/001-fundamental-analysis-platform/spec.md",
      "mirrors": [
        "plan.md",
        "tasks.md"
      ],
      "forbiddenOverrides": [
        "operation",
        "reports"
      ]
    },
    {
      "fieldId": "product_behavior",
      "scope": "Contracts, schemas, catalogues and fixtures",
      "authority": "specs/001-fundamental-analysis-platform/governance/authority-crosswalk.json -> primaryAuthority",
      "mirrors": [
        "batch primaryAuthorityRefs"
      ],
      "forbiddenOverrides": [
        "summaries",
        "implementation shortcuts"
      ]
    },
    {
      "fieldId": "task_definition",
      "scope": "Task IDs, dependencies, files, tests and Done when",
      "authority": "specs/001-fundamental-analysis-platform/tasks.md",
      "mirrors": [
        "implementation-control/TASK_SOURCE_LOCK.json",
        "implementation-control/batches/Bxx.json"
      ],
      "forbiddenOverrides": [
        "prompts",
        "reports"
      ]
    },
    {
      "fieldId": "implementation_state",
      "scope": "Completed boundary, active batch and next action",
      "authority": "implementation-control/IMPLEMENTATION_STATE.json",
      "mirrors": [
        "README.md",
        "START_HERE_CHATGPT.md"
      ],
      "forbiddenOverrides": [
        "PR body",
        "chat memory"
      ]
    },
    {
      "fieldId": "active_operation",
      "scope": "Immutable operation declaration: repository, base SHA, branch, allowlist, commands and promotion contract. Lifecycle state is GitHub-only.",
      "authority": "implementation-control/OPERATION.json",
      "mirrors": [],
      "forbiddenOverrides": [
        "PR body literals",
        "comments",
        "run IDs committed to Git"
      ]
    },
    {
      "fieldId": "operation_input_baseline",
      "scope": "Authenticated completed Sources pair used as input to the current operation and its expected GitHub base relation",
      "authority": "implementation-control/BASELINE_LOCK.json",
      "mirrors": [],
      "forbiddenOverrides": [
        "physical transport suffix",
        "candidate ZIP",
        "package containing the lock",
        "local extraction name"
      ]
    },
    {
      "fieldId": "github_evidence",
      "scope": "Checks, logs, artifacts, merge and Release facts",
      "authority": "GitHub commits, checks, artifacts, tags and Releases",
      "mirrors": [],
      "forbiddenOverrides": [
        "repository state files",
        "chat claims without executable evidence"
      ]
    },
    {
      "fieldId": "package_identity",
      "scope": "Identity of a candidate or completed ZIP",
      "authority": "Actual ZIP bytes + external sidecar + generated PACKAGE_METADATA.json",
      "mirrors": [],
      "forbiddenOverrides": [
        "repository state files",
        "physical transport suffix",
        "chat claims"
      ]
    }
  ],
  "conflictProcedure": {
    "mode": "FIELD_SCOPED_FAIL_CLOSED",
    "steps": [
      "Identify the conflicting field.",
      "Read only its declared authority.",
      "Block only the affected transition.",
      "Create a typed governance operation when authority itself must change.",
      "Never infer PASS or broaden scope from history or chat memory."
    ]
  },
  "historicalPolicy": {
    "reportsAreEvidenceNotAuthority": true,
    "failedEvidenceRetainedInGitHub": true,
    "historicalFilesMayBeExcludedFromReleasePackages": true
  }
}
