{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finscope.local/schemas/authority-matrix.schema.json",
  "type": "object",
  "required": ["schemaVersion", "fieldAuthorities", "conflictProcedure", "historicalPolicy"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "2.0.0" },
    "fieldAuthorities": {
      "type": "array", "minItems": 10,
      "items": {
        "type": "object",
        "required": ["fieldId", "scope", "authority", "mirrors", "forbiddenOverrides"],
        "properties": {
          "fieldId": { "type": "string" },
          "scope": { "type": "string" },
          "authority": { "type": "string" },
          "mirrors": { "type": "array", "items": { "type": "string" } },
          "forbiddenOverrides": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "conflictProcedure": { "type": "object" },
    "historicalPolicy": { "type": "object" }
  },
  "additionalProperties": false
}
