{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finscope.local/schemas/implementation-batch-map.schema.json",
  "type": "object",
  "required": [
    "schemaVersion", "mapId", "taskCount", "batchCount",
    "maximumTasksPerBatch", "sourceTasksSha256", "batches"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.1.0" },
    "mapId": { "type": "string", "minLength": 1 },
    "normativeBaseline": { "type": "string" },
    "packageRevision": { "type": "string" },
    "generatedOn": { "type": "string" },
    "sourceTaskAuthority": { "type": "string" },
    "sourceTasksSha256": { "pattern": "^[0-9a-f]{64}$" },
    "sourceCoverageMatrix": { "type": "string" },
    "taskCount": { "const": 109 },
    "batchCount": { "const": 25 },
    "maximumTasksPerBatch": { "type": "integer", "minimum": 1, "maximum": 6 },
    "subdivisionRule": { "type": "string" },
    "batches": {
      "type": "array", "minItems": 25, "maxItems": 25,
      "items": {
        "type": "object",
        "required": ["batchId", "ordinal", "batchFile", "taskIds", "taskCount", "status"],
        "properties": {
          "batchId": { "pattern": "^B(?:0[1-9]|1[0-9]|2[0-5])$" },
          "ordinal": { "type": "integer", "minimum": 1, "maximum": 25 },
          "title": { "type": "string" },
          "domain": { "type": "string" },
          "batchFile": { "type": "string" },
          "taskIds": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "pattern": "^T\\d{3}$" }, "uniqueItems": true },
          "taskCount": { "type": "integer", "minimum": 1, "maximum": 6 },
          "externalDependencies": { "type": "array", "items": { "pattern": "^T\\d{3}$" }, "uniqueItems": true },
          "status": { "enum": ["PENDING", "IN_PROGRESS", "LOCAL_VALIDATION_REQUIRED", "COMPLETED", "PARTIAL", "BLOCKED"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
