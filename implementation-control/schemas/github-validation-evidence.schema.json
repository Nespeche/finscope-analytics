{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finscope.local/schemas/github-validation-evidence.schema.json",
  "title": "FinScope GitHub validation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "result",
    "mode",
    "repository",
    "branch",
    "commitSha",
    "activeBatchId",
    "batchAuthoritySource",
    "baselineRole",
    "operationMatched",
    "remediationScope",
    "browserRequired",
    "startedAt",
    "finishedAt",
    "controlPlane",
    "releaseBaseline",
    "specify",
    "derivedBatchCommands",
    "executedCommands",
    "selfTests",
    "primaryFailure",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "result": { "enum": ["PASS", "FAIL"] },
    "mode": {
      "enum": [
        "GH0_BOOTSTRAP",
        "GH0_CLOSURE",
        "BATCH",
        "BATCH_CLOSURE",
        "RELEASE_REMEDIATION",
        "CONTROL_PLANE_REMEDIATION",
        "MAINTENANCE_REMEDIATION"
      ]
    },
    "repository": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runId": { "type": ["string", "null"] },
    "activeBatchId": { "type": "string", "pattern": "^B[0-9]{2}$" },
    "batchAuthoritySource": {
      "enum": ["IMPLEMENTATION_STATE", "MATCHED_OPERATION", null]
    },
    "baselineRole": {
      "enum": ["CURRENT_COMPLETED_BASELINE", "HISTORICAL_OPERATION_BASELINE", null]
    },
    "operationMatched": { "type": "boolean" },
    "remediationScope": {
      "type": ["object", "null"],
      "required": ["id", "allowedPaths", "changedPaths", "valid"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "allowedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "changedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "valid": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "browserRequired": { "type": "boolean" },
    "startedAt": { "type": "string" },
    "finishedAt": { "type": "string" },
    "controlPlane": {
      "type": "object",
      "required": ["result", "exitCode", "stdoutSha256", "stderrSha256"],
      "properties": {
        "result": { "enum": ["PASS", "FAIL"] },
        "exitCode": { "type": "integer" },
        "stdoutSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "stderrSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "releaseBaseline": {
      "type": "object",
      "required": [
        "result",
        "tag",
        "zipName",
        "sidecarName",
        "zipSha256",
        "assetIds",
        "root"
      ],
      "properties": {
        "result": { "enum": ["PASS", "FAIL"] },
        "tag": { "type": "string" },
        "zipName": { "type": "string" },
        "sidecarName": { "type": "string" },
        "zipSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "assetIds": {
          "type": "array",
          "minItems": 0,
          "items": { "type": "integer" }
        },
        "root": { "type": "string" },
        "failure": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "specify": {
      "type": "object",
      "required": ["count", "sha256", "expectedSha256", "byteIdentical"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "expectedSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byteIdentical": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "derivedBatchCommands": {
      "type": "array",
      "items": { "$ref": "#/$defs/commandDefinition" }
    },
    "executedCommands": {
      "type": "array",
      "items": { "$ref": "#/$defs/commandResult" }
    },
    "selfTests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "expected", "observed", "result"],
        "properties": {
          "id": { "type": "string" },
          "expected": { "type": "string" },
          "observed": { "type": "string" },
          "result": { "enum": ["PASS", "FAIL"] }
        },
        "additionalProperties": false
      }
    },
    "primaryFailure": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string" },
        "detail": { "type": "string" }
      },
      "required": ["code", "detail"],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "sizeBytes"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "commandDefinition": {
      "type": "object",
      "required": ["id", "category", "command", "required"],
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "command": { "type": "string" },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "commandResult": {
      "type": "object",
      "required": [
        "id",
        "category",
        "command",
        "status",
        "cwd",
        "startedAt",
        "finishedAt",
        "durationMs",
        "exitCode",
        "stdoutPath",
        "stderrPath",
        "stdoutSha256",
        "stderrSha256",
        "discovery",
        "reason"
      ],
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "command": { "type": "string" },
        "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "cwd": { "type": "string" },
        "startedAt": { "type": ["string", "null"] },
        "finishedAt": { "type": ["string", "null"] },
        "durationMs": { "type": ["integer", "null"], "minimum": 0 },
        "exitCode": { "type": ["integer", "null"] },
        "stdoutPath": { "type": "string" },
        "stderrPath": { "type": "string" },
        "stdoutSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "stderrSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "discovery": {
          "type": "object",
          "required": [
            "required",
            "discovered",
            "passed",
            "skipped",
            "pending",
            "valid"
          ],
          "properties": {
            "required": { "type": "boolean" },
            "discovered": { "type": "integer", "minimum": 0 },
            "passed": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 },
            "pending": { "type": "integer", "minimum": 0 },
            "valid": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
