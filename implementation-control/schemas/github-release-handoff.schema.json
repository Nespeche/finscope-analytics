{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finscope.local/schemas/github-release-handoff.schema.json",
  "title": "FinScope GitHub release handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "tag",
    "commitSha",
    "releaseId",
    "releaseRunId",
    "candidateRunId",
    "candidateArtifactId",
    "closureCommitSha",
    "closureRunId",
    "closureArtifactId",
    "assets",
    "baselineState"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "repository": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "releaseId": {
      "type": "integer"
    },
    "releaseRunId": {
      "type": "string"
    },
    "candidateRunId": {
      "type": "string"
    },
    "candidateArtifactId": {
      "type": "integer"
    },
    "closureRunId": {
      "type": "string"
    },
    "closureArtifactId": {
      "type": "integer"
    },
    "assets": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256",
          "sizeBytes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "baselineState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeBatchId",
        "nextAuthorizedBatchId",
        "completedTasksThrough",
        "convergenceAuthorized",
        "specifyTreeSha256"
      ],
      "properties": {
        "activeBatchId": {
          "const": "B12"
        },
        "nextAuthorizedBatchId": {
          "const": "B12"
        },
        "completedTasksThrough": {
          "const": "T048"
        },
        "convergenceAuthorized": {
          "const": false
        },
        "specifyTreeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "closureCommitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
