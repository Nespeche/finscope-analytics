{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finscope.local/schemas/implementation-state.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "normativeBaseline",
    "implementationStatus",
    "activeBatchId",
    "completedBatchIds",
    "blockedBatchIds",
    "completedTaskIds",
    "blockedTaskIds",
    "taskStatus",
    "batchStatus",
    "lastCompletedBatchId",
    "nextAuthorizedBatchId",
    "specifyTreeSha256",
    "sourceTasksSha256",
    "openFindings"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "2.0.0" },
    "project": { "const": "FinScope Analytics" },
    "normativeBaseline": { "const": "v0.21" },
    "implementationStatus": {
      "enum": ["READY", "IN_PROGRESS", "LOCAL_VALIDATION_REQUIRED", "PARTIAL", "BLOCKED", "COMPLETED"]
    },
    "activeBatchId": { "type": ["string", "null"], "pattern": "^B\\d{2}$" },
    "completedBatchIds": {
      "type": "array", "uniqueItems": true, "items": { "pattern": "^B\\d{2}$" }
    },
    "blockedBatchIds": {
      "type": "array", "uniqueItems": true, "items": { "pattern": "^B\\d{2}$" }
    },
    "completedTaskIds": {
      "type": "array", "uniqueItems": true, "items": { "pattern": "^T\\d{3}$" }
    },
    "blockedTaskIds": {
      "type": "array", "uniqueItems": true, "items": { "pattern": "^T\\d{3}$" }
    },
    "taskStatus": {
      "type": "object", "minProperties": 109, "maxProperties": 109,
      "additionalProperties": { "enum": ["PENDING", "IN_PROGRESS", "IMPLEMENTED_PENDING_VALIDATION", "COMPLETED", "BLOCKED"] }
    },
    "batchStatus": {
      "type": "object", "minProperties": 25, "maxProperties": 25,
      "additionalProperties": { "enum": ["PENDING", "IN_PROGRESS", "LOCAL_VALIDATION_REQUIRED", "COMPLETED", "PARTIAL", "BLOCKED"] }
    },
    "lastCompletedBatchId": { "type": ["string", "null"], "pattern": "^B\\d{2}$" },
    "nextAuthorizedBatchId": { "type": ["string", "null"], "pattern": "^B\\d{2}$" },
    "specifyTreeSha256": { "pattern": "^[0-9a-f]{64}$" },
    "sourceTasksSha256": { "pattern": "^[0-9a-f]{64}$" },
    "openFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "scope", "status", "description", "owner", "closureCondition"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string" },
          "scope": { "type": "string" },
          "status": { "enum": ["OPEN", "CLOSED", "DEFERRED"] },
          "description": { "type": "string" },
          "owner": { "type": "string" },
          "closureCondition": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
