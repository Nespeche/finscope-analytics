{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finscope.local/schemas/implementation-state.schema.json",
  "type": "object",
  "required": [
    "schemaVersion", "normativeBaseline", "packageRevision", "baselineRole",
    "phaseGate", "implementationStatus", "taskStatus", "batchStatus",
    "specifyTreeSha256", "sourceTasksSha256", "validationWorkflow"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.1.0" },
    "project": { "const": "FinScope Analytics" },
    "normativeBaseline": { "const": "v0.21" },
    "packageRevision": { "type": "string" },
    "activePackageLogicalName": { "type": "string" },
    "baselineRole": { "enum": ["ACTIVE_COMPLETED_BASELINE", "CANDIDATE_AWAITING_LOCAL_VALIDATION"] },
    "sourceBaseline": { "type": "object" },
    "normativeSourceBaseline": { "type": "object" },
    "phaseGate": {
      "type": "object",
      "required": ["tasksAuthorized", "analysisAuthorized", "implementationAuthorized", "convergenceAuthorized"],
      "properties": {
        "tasksAuthorized": { "const": true },
        "analysisAuthorized": { "const": true },
        "implementationAuthorized": { "const": true },
        "convergenceAuthorized": { "const": false }
      },
      "additionalProperties": false
    },
    "implementationStatus": { "enum": ["READY", "IN_PROGRESS", "LOCAL_VALIDATION_REQUIRED", "PARTIAL", "BLOCKED", "COMPLETED"] },
    "activeBatchId": { "type": ["string", "null"] },
    "completedBatchIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "blockedBatchIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "completedTaskIds": { "type": "array", "items": { "pattern": "^T\\d{3}$" }, "uniqueItems": true },
    "blockedTaskIds": { "type": "array", "items": { "pattern": "^T\\d{3}$" }, "uniqueItems": true },
    "taskStatus": {
      "type": "object", "minProperties": 109, "maxProperties": 109,
      "additionalProperties": { "enum": ["PENDING", "IN_PROGRESS", "IMPLEMENTED_PENDING_VALIDATION", "COMPLETED", "BLOCKED"] }
    },
    "batchStatus": {
      "type": "object", "minProperties": 25, "maxProperties": 25,
      "additionalProperties": { "enum": ["PENDING", "IN_PROGRESS", "LOCAL_VALIDATION_REQUIRED", "COMPLETED", "PARTIAL", "BLOCKED"] }
    },
    "lastCompletedBatchId": { "type": ["string", "null"] },
    "lastBatchReport": { "type": ["string", "null"] },
    "nextAuthorizedBatchId": { "type": ["string", "null"] },
    "specifyTreeSha256": { "pattern": "^[0-9a-f]{64}$" },
    "sourceTasksSha256": { "pattern": "^[0-9a-f]{64}$" },
    "validationWorkflow": {
      "type": "object",
      "required": ["candidatePromotionRule", "localProtocol", "evidenceSchema"],
      "properties": {
        "candidatePromotionRule": { "type": "string" },
        "localProtocol": { "type": "string" },
        "evidenceSchema": { "type": "string" },
        "pendingRuntimeValidationBatches": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "openFindings": { "type": "array" },
    "productCodePresent": { "type": "boolean" },
    "dependenciesInstalled": { "type": "boolean" },
    "buildArtifactsPresent": { "type": "boolean" },
    "updatedBy": { "type": "string" },
    "updatedOn": { "type": "string" }
  },
  "additionalProperties": false
}
