{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finscope.local/schemas/implementation-batch.schema.json",
  "type": "object",
  "required": [
    "schemaVersion", "batchId", "ordinal", "status", "taskCount",
    "executionOrder", "externalDependencies", "sourceTasksSha256",
    "tasks", "localValidation", "completionGate"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.1.0" },
    "batchId": { "pattern": "^B(?:0[1-9]|1[0-9]|2[0-5])$" },
    "ordinal": { "type": "integer", "minimum": 1, "maximum": 25 },
    "title": { "type": "string" },
    "domain": { "type": "string" },
    "status": { "enum": ["PENDING", "IN_PROGRESS", "LOCAL_VALIDATION_REQUIRED", "COMPLETED", "PARTIAL", "BLOCKED"] },
    "taskCount": { "type": "integer", "minimum": 1, "maximum": 6 },
    "executionOrder": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": { "pattern": "^T\\d{3}$" }, "uniqueItems": true
    },
    "externalDependencies": {
      "type": "array", "items": { "pattern": "^T\\d{3}$" }, "uniqueItems": true
    },
    "sourceTasksSha256": { "pattern": "^[0-9a-f]{64}$" },
    "requirements": { "type": "array", "items": { "pattern": "^(?:FR|NFR)-\\d{3}$" }, "uniqueItems": true },
    "acceptanceCriteria": { "type": "array", "items": { "pattern": "^AC-\\d{3}$" }, "uniqueItems": true },
    "authorityIds": { "type": "array", "items": { "pattern": "^AUTH-\\d{3}$" }, "uniqueItems": true },
    "primaryAuthorityRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "acceptanceAuthorityRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "fixtureRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "targetFiles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "testFiles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "contextPolicy": { "type": "object" },
    "tasks": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id", "phaseNo", "phase", "parallel", "dependencies",
          "requirementRefs", "acceptanceRefs", "authorityIds", "files",
          "tests", "doneWhen", "executability", "sourceTaskSha256"
        ],
        "properties": {
          "id": { "pattern": "^T\\d{3}$" },
          "phaseNo": { "type": "integer", "minimum": 1 },
          "phase": { "type": "string" },
          "story": { "type": ["string", "null"] },
          "parallel": { "type": "boolean" },
          "dependencies": { "type": "array", "items": { "pattern": "^T\\d{3}$" }, "uniqueItems": true },
          "requirementRefs": { "type": "array", "items": { "pattern": "^(?:FR|NFR)-\\d{3}$" }, "uniqueItems": true },
          "acceptanceRefs": { "type": "array", "items": { "pattern": "^AC-\\d{3}$" }, "uniqueItems": true },
          "authorityIds": { "type": "array", "items": { "pattern": "^AUTH-\\d{3}$" }, "uniqueItems": true },
          "files": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "tests": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "doneWhen": { "type": "string", "minLength": 1 },
          "executability": { "enum": ["EXECUTABLE", "MANUAL_EVIDENCE"] },
          "sourceTaskSha256": { "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "localValidation": {
      "type": "object",
      "required": ["mode", "browserRequired", "commands", "evidenceOutput", "closureRule"],
      "properties": {
        "mode": { "type": "string" },
        "browserRequired": { "type": "boolean" },
        "commands": {
          "type": "array", "minItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "category", "command", "required"],
            "properties": {
              "id": { "type": "string" },
              "category": { "type": "string" },
              "command": { "type": "string" },
              "required": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "evidenceOutput": { "type": "string" },
        "closureRule": { "type": "string" }
      },
      "additionalProperties": false
    },
    "completionGate": { "type": "object" }
  },
  "additionalProperties": false
}
